# Copiar este archivo como ".env" (en la raíz del proyecto) y completar los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# ===================== Backend (Django) =====================
# En producción (Render) estas variables se cargan en el panel de Render, no en este archivo.
# Lista completa y valores de producción: docs/04-Despliegue.md, sección 2.
# True solo en desarrollo local. En producción tiene que ser False.
DEBUG=True

# Clave secreta de Django. Generar una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Hosts permitidos, separados por coma. En Render no hace falta completarlo: el dominio
# del servicio se agrega solo (variable RENDER_EXTERNAL_HOSTNAME).
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend autorizados a llamar a la API, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Orígenes de confianza para el panel de administración en producción (con https://). Vacío en local.
# En Render tampoco hace falta: el dominio del servicio se agrega solo.
CSRF_TRUSTED_ORIGINS=

# Base de datos. Si queda vacío se usa SQLite local (archivo db.sqlite3), útil para desarrollar.
# Para Supabase: copiar la cadena "Session pooler" del botón Connect del proyecto y reemplazar
# [YOUR-PASSWORD] por la contraseña de la base. Formato:
#   postgresql://postgres.<ref-del-proyecto>:<CONTRASEÑA>@aws-N-<región>.pooler.supabase.com:5432/postgres?sslmode=require
# Si la contraseña tiene caracteres especiales (@ : / # ? % &) hay que codificarlos (ver docs/04-Despliegue.md).
DATABASE_URL=

# ===================== Frontend (React + Vite) =====================
# URL del backend. En producción: la URL pública del backend en Render.
VITE_API_URL=http://localhost:8000
